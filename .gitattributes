# Dataset manifests hash the exact generated bytes; never rewrite line endings.
data/instances/**/*.json -text
# Preserve byte hashes in frozen normalization manifests.
configs/manifests/*.json -text whitespace=cr-at-eol
# Match the preserved v1 byte hashes on every platform.
data/instances/fixed_instance.yaml text eol=crlf
data/manifests/*/manifest.json text eol=crlf
# Preserve v2 manifests, selections and original configuration snapshot bytes.
data/manifests/v2/** -text whitespace=cr-at-eol
# Preserve challenge index, manifests and audit bytes referenced by SHA256.
data/manifests/challenge_v1/** -text whitespace=cr-at-eol
configs/archive/*.json -text whitespace=cr-at-eol
# Keep schema-3 datasets and migration provenance hashes stable across platforms.
data/instances/v3/** -text whitespace=cr-at-eol
data/manifests/v3/** -text whitespace=cr-at-eol
configs/factorial27_normalization.json -text whitespace=cr-at-eol
configs/factorial27_variance_normalization.json -text whitespace=cr-at-eol
result/migration/** -text whitespace=cr-at-eol
